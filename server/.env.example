# Bu dosyayı ".env" adıyla kopyala ve kendi bilgilerinle doldur. .env asla commit'lenmez.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parallell

PORT=3000

# Puan miktarları henüz kesinleşmedi: geçici varsayılanlar
PARTICIPATION_POINTS=10
EARLY_BONUS_POINTS=5
EARLY_BONUS_LIMIT=100

# Bu kadar farklı kişi bildirince fotoğraf otomatik gizlenir
REPORT_HIDE_THRESHOLD=3

# Günlük kapsül
OPEN_HOUR_ISTANBUL=20

# Test için mağazayı ücretsiz yap (yayında mutlaka false)
SHOP_FREE=false
