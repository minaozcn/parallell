    "db:unseed": "node --env-file=.env seed-mock.js --clean",
    "db:seed:connect": "node --env-file=.env seed-connect.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  }
